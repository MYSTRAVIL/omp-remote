# Maintainer deploy variables. Copy to the gitignored root .env.
# Bun loads it when you run `bun run deploy:web` or `bun run deploy:aggregator`
# from the repo root. The deploy scripts refuse to run when either is unset.
#
# omp-remote itself reads ~/.omp-remote/config.json, not environment variables.
# See docs/SELF-HOSTING.md.

# SSH destination of the server, with root access (root@host).
OMP_DEPLOY_HOST=
# Public base URL of the deployed service (https://omp-remote.example.com).
OMP_DEPLOY_URL=
